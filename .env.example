# Copy to .env.local for local development. Never put production values here,
# and never point a local run at the production database (see CLAUDE.md).

# Supabase (local stack: `supabase start` prints these). Read through src/lib/env.ts.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never import it into browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Signs staff and participant sessions and email links. Any long random string locally.
SESSION_SECRET=
# Signs invitation and unsubscribe links. In production it must never change once set.
INVITE_LINK_SECRET=
# Bearer secret for /api/cron/* (see docs/ops/cron.md).
CRON_SECRET=

# Email (Resend). Leave empty locally so nothing is sent; stub senders instead.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_FROM_UNDANGAN=
EMAIL_REPLY_TO=
# Comma-separated test addresses. On preview builds only these receive email.
MESSAGING_ALLOWLIST=

# Optional external scanner API used by participant sync.
SCANNER_API_BASE_URL=
SCANNER_API_KEY=
SCANNER_API_EVENT_SLUG=

# Shown in the admin footer and the system guide.
NEXT_PUBLIC_APP_VERSION=
